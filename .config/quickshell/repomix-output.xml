                    // WEEKDAYS
                    GridLayout {
                        Layout.fillWidth: true

                        columns: 7

                        rowSpacing: 0
                        columnSpacing: 0

                        Repeater {
                            model: [
                                "SUN",
                                "MON",
                                "TUE",
                                "WED",
                                "THU",
                                "FRI",
                                "SAT"
