        }

        MouseArea {
            anchors.fill: parent

            cursorShape:
                Qt.PointingHandCursor

            onClicked: {
                button.clicked()
            }
        }
    }

    Process {
        id: shutdownProcess

        command: [
            "systemctl",
            "poweroff"
        ]
    }

    Process {
        id: rebootProcess

        command: [
            "systemctl",
            "reboot"
        ]
    }

    Process {
        id: suspendProcess

